{
  "$schema": "https://example.invalid/dsh-trash-guard/rules.schema.json",
  "version": 1,
  "note": "dsh-trash-guard 外置规则。command=黑名单（命中即拦）；allow=白名单（判定前把匹配段掩成 X，只掩片段不丢整行，条目必须写窄）。改本文件即时生效（插件按 mtime 热加载），不需要重启 dsh；改坏了会自动回退到内置规则并打 warn。",
  "allow": [
    {
      "id": "env-var-cleanup",
      "label": "Remove-Item Env:<name>（只删进程环境变量，不是文件）",
      "pattern": "Remove-Item\\s+Env:\\\\?[A-Za-z0-9_]+",
      "flags": "gi"
    },
    {
      "id": "regex-test-literal",
      "label": "PowerShell 比较运算符左侧的引号字面量（-match/-notmatch/-like 只做匹配，不执行；双引号内不含 $/反引号，防 $(...) 注入）",
      "pattern": "('[^']*'|\"[^\"$`\\n]*\")\\s+-(?:match|notmatch|like)\\b",
      "flags": "gi"
    },
    {
      "id": "scan-arg-quoted",
      "label": "只读扫描/匹配开关的引号参数（-Pattern/-Match 等，参数是数据不是命令；双引号内不含 $/反引号，防 $(...) 注入）",
      "pattern": "(?:-(?:pattern|match|notmatch|simplematch|filter|include|exclude)\\b|--(?:pattern|regexp|include|exclude))\\s+('[^']*'|\"[^\"$`\\n]*\")",
      "flags": "gi"
    },
    {
      "id": "single-lock-cleanup",
      "label": "os.remove(SINGLE_LOCK)：应用自身单实例锁清理（仅此字面量）",
      "pattern": "os\\.remove\\(\\s*SINGLE_LOCK\\s*\\)",
      "flags": "gi"
    },
    {
      "id": "git-commit-message",
      "label": "git commit -m 的提交说明（引号内是数据，不是命令；双引号内不含 $/反引号，防 $(...) 注入）",
      "pattern": "\\bgit\\s+commit\\b[^\\n;|&]*?\\s-m\\s+('[^']*'|\"[^\"$`\\n]*\")",
      "flags": "gi"
    },
    {
      "id": "json-flag-arg",
      "label": "--json 的参数（证据/配置数据，不是命令；双引号内不含 $/反引号，防 $(...) 注入；执行器开关如 -c/-e 不在其中）",
      "pattern": "--json\\s+('[^']*'|\"[^\"$`\\n]*\")",
      "flags": "gi"
    },
    {
      "id": "go-regex-receiver",
      "label": "Go 正则片段里转义的接收者名（反斜杠 + 括号 + rm，不是删除命令；真命令 $(rm ...) 无反斜杠不匹配）",
      "pattern": "\\\\\\(rm\\s+\\\\\\*",
      "flags": "gi"
    }
  ],
  "launchAllow": [
    {
      "path": "E:\\claude综合\\mmtls微信解密\\截流软件\\web_screen\\screen_server.py",
      "sha256": "4c7b568f0f969d04b8ba29d5140b9ddec0b643d29f9125e956cc325896ddbb8d",
      "reason": "WEB筛选本地服务启动入口；正文 os.remove(tmp) 只清导出临时文件（2026-11-25 用户授权自决）"
    },
    {
      "path": "E:\\claude综合\\mmtls微信解密\\截流软件\\ui\\tab_keyword.py",
      "sha256": "87970b77eb10f70b5c89dcaf07663602716f9ec089ed673a90b5ae84d3ac2cbe",
      "reason": "关键词采集 Tab 启动入口；正文 os.remove(p) 只清临时文件（2026-11-25 用户授权自决）"
    }
  ],
  "command": [
    {
      "id": "remove-item",
      "label": "Remove-Item / rm / del / rd / rmdir / unlink",
      "pattern": "(?:^|[\\r\\n;|&({])\\s*(?:remove-item|clear-item|ri|rm|del|erase|rd|rmdir|unlink)(?=\\s|/|$|[\"'])(?!\\s*=)",
      "flags": "i"
    },
    {
      "id": "clear-content",
      "label": "Clear-Content",
      "pattern": "(?:^|[\\r\\n;|&({])\\s*clear-content\\b",
      "flags": "i"
    },
    {
      "id": "truncate",
      "label": "Set-Content -Value '' / $null（清空文件内容）",
      "pattern": "\\bset-content\\b[^\\n;|]*?\\s-value\\s+(?:''|\"\"|\\$null)(?=\\s|$)",
      "flags": "i"
    },
    {
      "id": "dotnet-delete",
      "label": "[System.IO.File]::Delete 一类 .NET 直调",
      "pattern": "\\[\\s*(?:[A-Za-z0-9_.]*\\.)?(?:file|directory|fileinfo|directoryinfo)\\s*\\]\\s*::\\s*delete",
      "flags": "i"
    },
    {
      "id": "method-delete",
      "label": "对象上的 .Delete() / .Delete($true) 方法",
      "pattern": "\\.\\s*delete\\s*\\(\\s*(?:\\$?(?:true|false)\\s*)?\\)",
      "flags": "i"
    },
    {
      "id": "git-destructive",
      "label": "git clean / git reset --hard / git checkout -- .",
      "pattern": "\\bgit\\s+(?:clean\\b|reset\\s+--hard\\b|checkout\\s+--\\s+\\.)",
      "flags": "i"
    },
    {
      "id": "encoded-command",
      "label": "-EncodedCommand（内容不可见，无法审计）",
      "pattern": "-encodedcommand\\b",
      "flags": "i"
    },
    {
      "id": "robocopy-purge",
      "label": "robocopy /MIR|/PURGE（镜像即删除多余项）",
      "pattern": "\\brobocopy\\b[^\\n]*\\s\\/(?:mir|purge)\\b",
      "flags": "i"
    },
    {
      "id": "runtime-api-delete",
      "label": "shutil.rmtree / os.remove / fs.rm / fs.unlink 等脚本 API",
      "pattern": "\\b(?:shutil\\.rmtree|os\\.remove|os\\.unlink|os\\.rmdir|fs\\.rm\\(|fs\\.rmSync|fs\\.unlink|fs\\.unlinkSync|fs\\.rmdir)\\b",
      "flags": "i"
    },
    {
      "id": "disk-destructive",
      "label": "diskpart / Clear-Disk / Format-Volume / vssadmin delete",
      "pattern": "\\b(?:diskpart|clear-disk|format-volume|initialize-disk|vssadmin\\s+delete)\\b",
      "flags": "i"
    },
    {
      "id": "overwrite-move",
      "label": "Move-Item -Force（覆盖目标 = 目标消失）",
      "pattern": "(?:^|[\\r\\n;|&({])\\s*(?:move-item|mv|move)\\b[^\\n]*?\\s-force\\b",
      "flags": "i"
    },
    {
      "id": "cmd-wrapper",
      "label": "cmd /c del|erase|rd|rmdir",
      "pattern": "\\bcmd(?:\\.exe)?\\s+[^\\n]*?\\/(?:c|k)\\s+[^\\n]*?\\b(?:del|erase|rd|rmdir|deltree)(?=[\\s\"']|$)",
      "flags": "i"
    }
  ],
  "batch": {
    "id": "bat-delete",
    "label": "批处理里的 del/erase/rd/rmdir（行中任意位置）",
    "pattern": "(?:^|[\\s&|(])(?:del|erase|rd|rmdir)(?=[\\s/\"']|$)",
    "flags": "i"
  },
  "docExempt": {
    "targets": "(?:add-content|set-content|out-file)\\b[^\\n;|]*?\\s(?:-literalpath|-filepath|-path)?\\s*['\"]?([^\\s'\";|]+\\.(?:md|markdown|txt|json|jsonl|log|csv|ya?ml))['\"]?",
    "executors": "\\b(?:invoke-expression|iex|start-process|cmd(?:\\.exe)?\\s+\\/[ck]|bash\\s+-c|sh\\s+-c|python[0-9.]*\\s+-[ce]|node\\s+-e)\\b"
  }
}
